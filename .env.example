# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────
# Google AI Studio key: https://aistudio.google.com/apikey (free tier, no card)
GEMINI_API_KEY=your_key_here

# Signs JWTs. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_secret_here

# ── Optional ──────────────────────────────────────────────────────────────
# Model used for anomaly explanations. A "-latest" alias tracks Google's
# current model, so a retired version cannot silently break explanations.
# Pin a specific version (e.g. gemini-3.6-flash) only to work around a
# regression in the default.
GEMINI_MODEL=gemini-flash-lite-latest

# How many anomalies per analysis get a real AI explanation. The rest keep the
# deterministic text. Requested in one batched call, not one call each.
MAX_AI_EXPLANATIONS=25

# Extra browser origins allowed by CORS, comma separated. localhost:3000 and
# the production Vercel domain are always allowed.
# CORS_ORIGINS=https://my-preview.example.com
